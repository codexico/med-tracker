{
  "expo": {
    "name": "MeusRemedinhos",
    "slug": "MeusRemedinhos",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "meusremedinhos",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.franciscokahil.appMeusRemedinhos"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.franciscokahil.appMeusRemedinhos"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-pill.png",
          "color": "#8b6f47"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-localization",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/material.ttf"
          ],
          "widgets": [
            {
              "name": "DailyList",
              "label": "Lista Diária",
              "targetCellWidth": 4,
              "minWidth": "218dp",
              "maxWidth": "624dp",
              "targetCellHeight": 2,
              "minHeight": "56dp",
              "maxHeight": "800dp",
              "resizeMode": "horizontal|vertical",
              "description": "Lista de medicamentos diária",
              "previewImage": "./assets/widget-preview/daily-list-preview.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "NextEvent",
              "label": "Próximo Medicamento",
              "targetCellWidth": 2,
              "minWidth": "109dp",
              "maxWidth": "218dp",
              "targetCellHeight": 1,
              "minHeight": "56dp",
              "maxHeight": "80dp",
              "resizeMode": "horizontal",
              "description": "Próximo medicamento a tomar",
              "previewImage": "./assets/widget-preview/next-event-preview.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0195fa60-3415-4696-a658-295aba1ba13f"
      }
    },
    "owner": "franciscokahil",
    "updates": {
      "url": "https://u.expo.dev/0195fa60-3415-4696-a658-295aba1ba13f"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}